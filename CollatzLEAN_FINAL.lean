-- SECTION 0: FOUNDATIONAL DEFINITIONS
-- Formalizing the "Modular Loop Framework" and "Perturbation Model"
-- ===============================================================

-- 1) MODULO RESIDUAL FORM OF INTEGERS
-- Paper Reference: "x = 2^v * k + m" (Section 2.1)

/--
Structure representing an integer in Modular Form (2^v * k + m).
We use ℤ for k (core integer) to allow for algebraic manipulation.
-/
structure ModularInt (v : ℕ) where
  k : ℤ      -- Core integer
  m : ℕ      -- Residue
  h_odd : m % 2 = 1     -- m is odd
  h_bound : m < 2^v     -- m is a valid residue modulo 2^v

/-- Helper to convert ModularInt back to standard Integer value -/
def ModularInt.val (x : ModularInt v) : ℤ :=
  (2 : ℤ)^v * x.k + x.m

-- 2) ODD-TO-ODD COLLATZ ITERATION
-- Paper Reference: "T(n) = (3n+1)/2^a" where a = v2(3n+1)

/-- The standard Collatz 'Next Odd' function -/
def next_odd (n : ℕ) : ℕ :=
  let step1 := 3 * n + 1
  let a := step1.factorization 2
  step1 / (2 ^ a)

/-- The specific exponent generated by a step -/
def step_exponent (n : ℕ) : ℕ :=
  (3 * n + 1).factorization 2

-- 3) MULTIPLE ITERATIONS, MODULAR LOOP, MODULAR PATH
-- Paper Reference: Definition 2 & 3 (Section 7)

/--
A Modular Path is the sequence of integers generated by iterating
the odd-map 'len' times starting from 'start'.
-/
def trajectory (start : ℕ) (len : ℕ) : List ℕ :=
  match len with
  | 0 => [start]
  | n + 1 => start :: trajectory (next_odd start) n

/--
The sequence of division exponents (a_1, a_2, ..., a_n) generated by a path.
-/
def exponent_vector (start : ℕ) (len : ℕ) : List ℕ :=
  (trajectory start (len - 1)).map step_exponent

/--
Definition 2: A Modular Loop.
A path forms a loop modulo 2^v if the final residue equals the starting residue.
-/
def is_modular_loop (start : ℕ) (len : ℕ) (v : ℕ) : Prop :=
  let end_val := (trajectory start len).getLast!
  start % (2^v) = end_val % (2^v)

-- 4) INTEGER LOOP DEFINED IN FORM OF MODULAR LOOP
-- Paper Reference: Equation (v) in Section 7.1

def is_integer_loop (start : ℕ) (len : ℕ) : Prop :=
  let path := trajectory start len
  path.head! = path.getLast!

-- 5) EQUILIBRIUM STATE
-- Paper Reference: "Equilibrium State... all division exponents a_i = 2" (Lemma 1A)

def is_equilibrium_state (exps : List ℕ) : Prop :=
  ∀ a ∈ exps, a = 2

-- 6) PERTURBATION FROM EQUILIBRIUM
-- Paper Reference: "Perturbation δ_i = a_i - 2" (Section 4)

/--
Calculates the perturbation vector δ given an exponent vector a.
Returns Integers since δ can be negative (e.g., 1 - 2 = -1).
-/
def perturbation_vector (exps : List ℕ) : List ℤ :=
  exps.map (λ a => (a : ℤ) - 2)

/--
The Cycle Condition in terms of Perturbations (Lemma 1B).
This version takes a List (used in legacy definitions).
-/
def S_prime_sum (deltas : List ℤ) : ℤ :=
  deltas.sum

/--
The Prefix Sum function (S').
This version takes a function (ℕ → ℤ) and is used in the rigorous Lemma 1F/1G proofs.
-/
def S_prime (delta : ℕ → ℤ) (j : ℕ) : ℤ :=
  (range j).sum (λ i => delta i)

